local function toggle(r, default, cb)
	local track = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(40, 20), Text = "", AutoButtonColor = false, BorderSizePixel = 0,
	}, r)
	corner(track, 10)
	local knob = new("Frame", {Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0, BackgroundColor3 = C.text}, track)
	corner(knob, 8)
	local state = default
	local function render(instant)
		local pos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
		local col = state and C.accent or C.off
		if instant then
			knob.Position, track.BackgroundColor3 = pos, col
		else
			TweenService:Create(knob, TweenInfo.new(0.15), {Position = pos}):Play()
			TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3 = col}):Play()
		end
	end
	render(true)
	track.MouseButton1Click:Connect(function()
		state = not state
		render()
		cb(state)
	end)
end

local function button(r, text, color, cb)
	local b = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(78, 26), BackgroundColor3 = color, BorderSizePixel = 0,
		Text = text, TextColor3 = C.text, Font = Enum.Font.Arcade, TextSize = 13,
	}, r)
	corner(b, 6)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

local function input(r, default)
	local box = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(60, 26), BackgroundColor3 = Color3.fromRGB(60, 46, 84),
		BorderSizePixel = 0, Text = tostring(default), TextColor3 = C.text,
		ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 14,
	}, r)
	corner(box, 6)
	return box
end

