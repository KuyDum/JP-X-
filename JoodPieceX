-- ใส่โค้ด
local rCode = row(codeSec, "Redeem All", #codes .. " codes")
local rCodeDelay = row(codeSec, "Code Delay", "วินาทีต่อโค้ด")
local codeDelayBox = input(rCodeDelay, CODE_DELAY)

local codeBusy, codeCancel = false, false
button(rCode, "Start", C.green, function(btn)
	if codeBusy then codeCancel = true return end
	codeBusy, codeCancel = true, false
	btn.Text = "Stop"
	btn.BackgroundColor3 = C.red
	task.spawn(function()
		local d = math.clamp(tonumber(codeDelayBox.Text) or CODE_DELAY, 1, 30)
		local stopped = false
		for i, code in ipairs(codes) do
			if codeCancel or not gui.Parent then stopped = true break end
			pcall(function() codeRemote:FireServer(code) end)
			setStatus(("ใส่โค้ด %d/%d: %s"):format(i, #codes, code))
			task.wait(d)
		end
		codeBusy = false
		if gui.Parent then
			setStatus(stopped and "หยุดใส่โค้ดแล้ว" or "ใส่โค้ดครบแล้ว")
			btn.Text = "Start"
			btn.BackgroundColor3 = C.green
		end
	end)
end)

-- สุ่มของ
local rAmount = row(roll_sec, "Amount", "สูงสุด " .. MAX_ROLL)
local amountBox = input(rAmount, MAX_ROLL)
local rRoll = row(roll_sec, "Roll Once", "สุ่ม 1 ครั้ง")
local rAuto = row(roll_sec, "Auto Roll", "สุ่มต่อเนื่อง")
local rAutoDelay = row(roll_sec, "Auto Delay", "วินาที (ต่ำสุด 0.01)")
local autoDelayBox = input(rAutoDelay, 1)

local rolls = 0
local function roll()
	local n = math.clamp(math.floor(tonumber(amountBox.Text) or MAX_ROLL), 1, MAX_ROLL)
	amountBox.Text = tostring(n)
	pcall(function() rollRemote:FireServer(n) end)
	rolls += 1
	setStatus(("สุ่มแล้ว %d ครั้ง (ส่งค่า %d)"):format(rolls, n))
end
button(rRoll, "Roll", Color3.fromRGB(80, 110, 200), function() roll() end)

local auto = false
toggle(rAuto, false, function(on)
	auto = on
	if on then
		task.spawn(function()
			while auto and gui.Parent do
				roll()
				task.wait(math.max(tonumber(autoDelayBox.Text) or 1, 0.01))
			end
		end)
	else
		setStatus("หยุดสุ่มอัตโนมัติ")
	end
end)

